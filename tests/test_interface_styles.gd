extends Node
const App=preload("res://scenes/app/app_root.tscn")
const Preferences=preload("res://scripts/app/appearance_preferences.gd")
const Styles=preload("res://scripts/presentation/interface_styles.gd")
const Palette=preload("res://scripts/app/app_theme.gd")
var checks:int=0
var failures:int=0
func check(ok:bool,message:String) -> void:
	checks+=1
	if not ok:failures+=1;push_error("InterfaceStyles: "+message)
func settle() -> void:await get_tree().process_frame;await get_tree().process_frame
func _ready() -> void:
	var path:String="user://style001-test.cfg"
	DirAccess.remove_absolute(path)
	var prefs:=Preferences.new(path)
	check(prefs.load_preferences()==OK and prefs.style_id==&"arcane","missing preference defaults to Arcane")
	check(not FileAccess.file_exists(path),"loading does not create a file")
	check(prefs.save_style(&"berserk")==OK,"save explicit Berserk choice")
	var reload_prefs:=Preferences.new(path)
	check(reload_prefs.load_preferences()==OK and reload_prefs.style_id==&"berserk","choice survives a fresh store")
	var original:String=FileAccess.get_file_as_string(path)
	check(prefs.save_style(&"unknown")==ERR_INVALID_PARAMETER and FileAccess.get_file_as_string(path)==original,"unknown choice cannot overwrite preference")
	var file:=FileAccess.open(path,FileAccess.WRITE);file.store_string('[appearance]\nstyle="unknown"\n');file.close()
	check(reload_prefs.load_preferences()==ERR_INVALID_DATA and reload_prefs.style_id==&"arcane","invalid saved style defaults safely")
	file=FileAccess.open(path,FileAccess.WRITE);file.store_string('[appearance]\nstyle=4\n');file.close()
	check(reload_prefs.load_preferences()==ERR_INVALID_DATA,"invalid value type is rejected")
	var unavailable:=Preferences.new("user://missing-style001/folder.cfg")
	check(unavailable.save_style(&"berserk")!=OK and unavailable.style_id==&"arcane","save failure retains prior choice")
	var arcane:Resource=Styles.get_style(&"arcane");var berserk:Resource=Styles.get_style(&"berserk")
	var arcane_color:Color=arcane.palette.get_stylebox("normal","Button").bg_color
	var app=App.instantiate();app.save_path="";add_child(app);await settle()
	check(app.interface_style==arcane and app.background.texture==arcane.home_background,"Home starts Arcane")
	check(app.style_button.text.is_empty() and app.style_button.icon!=null,"icon-only style button")
	check(app.style_button.size==Vector2(48,48) and app.style_button.get_global_rect().end.x<=get_viewport().get_visible_rect().end.x-16,"touch size and safe right margin")
	var press:=InputEventMouseButton.new();press.position=app.style_button.get_global_rect().get_center();press.button_index=MOUSE_BUTTON_LEFT;press.pressed=true
	get_viewport().push_input(press,true);var release=press.duplicate();release.pressed=false;get_viewport().push_input(release,true);await settle()
	check(app.interface_style==berserk,"one click switches once")
	check(app.background.texture==berserk.home_background and app.home_page.theme==berserk.palette,"Home background and palette switch together")
	check(app.home_lighting.profile==berserk.home_lights and app.home_lighting.profile.braziers.is_empty(),"Berserk has its own calibrated warm lights")
	check(app.style_button.tooltip_text.contains("Arcane"),"tooltip names destination")
	for i in range(16):app.toggle_interface_style()
	await settle()
	check(app.interface_style==berserk and app.home_lighting.get_child_count()==berserk.home_lights.candles.size(),"repeated toggles leave exactly one light set")
	check(arcane.palette.get_stylebox("normal","Button").bg_color==arcane_color,"shared Arcane resource never mutated")
	app.notification(NOTIFICATION_APPLICATION_FOCUS_OUT);app.toggle_interface_style()
	check(app.interface_style==berserk and app.style_button.disabled,"background blocks switching")
	app.notification(NOTIFICATION_APPLICATION_FOCUS_IN);await settle()
	app.open_team();await settle()
	check(app.team_page.appearance==berserk and app.team_page.theme==berserk.palette and app.team_page.background.texture==berserk.page_background,"team inherits Berserk style")
	check(app.team_page.empty_frames[3].get_theme_stylebox("panel").border_color==berserk.frame_color,"empty card keeps matching frame")
	app.toggle_interface_style();check(app.interface_style==berserk,"switch guarded outside Home")
	app._select_team_hero(&"mako");await settle()
	check(app.hero_page.appearance==berserk and app.hero_page.theme==berserk.palette and app.hero_page.background.texture==berserk.page_background,"character sheet inherits Berserk")
	app.open_gambits();await settle()
	var editor=app.gambits_page.editor
	check(app.gambits_page.background.texture==berserk.page_background,"gambits use balcony art")
	check(editor.theme.get_color("arrow_color","OptionButton")==berserk.editor_accent,"dropdown arrows use selected palette")
	check(editor.theme.get_stylebox("panel","PopupMenu").bg_color==berserk.editor_background,"popup menus follow palette")
	var token:int=editor.tokens[0];var rows:Array=editor.rows.duplicate(true)
	editor.apply_palette(arcane.palette,arcane.editor_accent,arcane.editor_background)
	check(editor.rows==rows and editor.tokens[0]==token,"restyling preserves rows and callback tokens")
	app.return_home();await settle();app.open_arena();await settle()
	check(app.combat.theme==null and app.theme==arcane.palette,"combat retains original inherited palette")
	check(app.interface_style==berserk,"entering combat does not overwrite selected style")
	app.return_home();await settle();app.toggle_interface_style();await settle()
	check(app.interface_style==arcane and app.home_lighting.profile==arcane.home_lights,"switch back restores original art and lights")
	var old:Theme=Palette.editor_theme();var styled:Theme=Palette.editor_theme(arcane.palette,arcane.editor_accent,arcane.editor_background)
	for state in ["scroll","grabber","grabber_highlight","grabber_pressed"]:check(old.get_stylebox(state,"VScrollBar").bg_color==styled.get_stylebox(state,"VScrollBar").bg_color,"Arcane scrollbar preserved: "+state)
	app.queue_free();await settle();DirAccess.remove_absolute(path)
	var label:=Label.new();label.text="%d controles, %d echecs"%[checks,failures];add_child(label)
