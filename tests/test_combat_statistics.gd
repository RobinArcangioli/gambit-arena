extends Node
const Menu=preload("res://scripts/ui/combat_statistics_menu.gd")
const Report=preload("res://scripts/party/combat_report.gd")
const App=preload("res://scenes/app/app_root.tscn")
var checks:int=0
var failures:int=0
func check(ok:bool,text:String) -> void:
	checks+=1
	if not ok:failures+=1;push_error("CombatStatistics: "+text)
func settle() -> void:await get_tree().process_frame;await get_tree().process_frame
func tap(viewport:Viewport,button:Control) -> void:
	var at:Vector2=button.get_global_rect().get_center()
	for pressed in [true,false]:
		var finger:=InputEventScreenTouch.new();finger.position=at;finger.index=0;finger.pressed=pressed;viewport.push_input(finger,true)
		var mouse:=InputEventMouseButton.new();mouse.device=-1;mouse.position=at;mouse.global_position=at;mouse.button_index=MOUSE_BUTTON_LEFT;mouse.pressed=pressed;mouse.button_mask=MOUSE_BUTTON_MASK_LEFT if pressed else 0;viewport.push_input(mouse,true)
func event(sequence:int,source:int,target:int,damage:int=0,healing:int=0) -> Dictionary:
	return {"run_id":1,"kind":"resolve","sequence":sequence,"source_id":source,"target_id":target,"damage":damage,"healing":healing,"skill":"heal" if healing>0 else "basic","game_time":1.0}
func _ready() -> void:
	var report:=Report.new();report.enabled=true;report.begin(1)
	report.register_actor(1,"Mako",0,0,180,60,0);report.register_actor(2,"Anne",0,1,140,60,0)
	report.begin_wave(1,0);report.register_actor(3,"Squelette #1",1,0,60,0,0)
	check(report.mvp_id()==0,"no MVP before an effective contribution")
	var hit:Dictionary=event(1,1,3,12)
	report.consume(hit);report.consume(hit)
	check(report.actors[1].dealt==12 and report.actors[3].received==12,"real damage attributed exactly once")
	report.consume(event(1,2,1,0,17))
	check(report.mvp_id()==2 and report.ordered()[0].id==1,"MVP contribution differs from damage-only ordering")
	report.consume(event(2,1,2,5))
	check(report.actors[2].received==5 and report.mvp_id()==1,"friendly damage counted, MVP tie favors damage")
	report.consume(event(2,2,3,0,9))
	check(report.actors[2].healed==26,"healing an enemy remains credited to actual healer")
	report.consume({"run_id":1,"kind":"death","actor_id":3,"source_id":3,"game_time":2.0})
	check(report.actors.has(3) and not report.actors[3].alive,"dead enemy retained during current wave")
	var count:int=report.entries
	report.begin_wave(2,3)
	check(not report.actors.has(3) and report.actors[1].dealt==17 and report.actors[2].healed==26,"new wave wipes only enemy statistics")
	check(report.entries>count and report.recent.any(func(row):return "Squelette #1" in row.text),"journal survives new wave")
	report.consume({"run_id":1,"kind":"buff_applied","sequence":3,"source_id":1,"target_id":2,"skill":"booster","buff_id":"booster","buff_duration":60.0,"time_multiplier":1.3,"game_time":3.0})
	check(report.recent.back().text.contains("Mako → Anne") and report.recent.back().text.contains("60,0 s") and report.recent.back().text.contains("30 %"),"readable buff source target duration and value")
	report.expire(2,"booster",63)
	check(report.actors[2].buffs.is_empty() and report.recent.back().text.contains("prend fin"),"buff expiry is logged once from authoritative state")
	report.register_actor(4,"Squelette #2",1,1,60,0,63)
	report.consume(event(1,4,1,200))
	check(report.mvp_id()==2,"enemy cannot become hero MVP")
	var before_recovery:int=report.entries
	report.consume({"run_id":1,"kind":"end","sequence":100,"source_id":1,"skill":"basic","game_time":63.001})
	report.consume({"run_id":1,"kind":"cancel","sequence":101,"source_id":1,"skill":"basic","was_preparing":false,"game_time":63.002})
	check(report.entries==before_recovery,"attack recovery completion and interruption stay out of journal")
	report.consume({"run_id":1,"kind":"end","sequence":102,"source_id":1,"skill":"lightning","game_time":63.003})
	check(report.entries==before_recovery+1 and "récupération de Foudre" in report.recent.back().text,"spell recovery remains logged")
	report.consume({"run_id":1,"kind":"cancel","sequence":103,"source_id":1,"target_id":4,"skill":"lightning","was_preparing":true,"game_time":63.004})
	check("annulation" in report.recent.back().text and not "aucun PM" in report.recent.back().text,"cancel messages omit mana disclaimer")
	check(Menu.timestamp(.001)=="00:00.001" and Menu.timestamp(123.456)=="02:03.456","event timestamp includes three millisecond digits")
	check(Menu.timestamp(59.9996)=="01:00.000" and Menu.timestamp(-1)=="00:00.000","millisecond rounding carries across minute boundary")
	var stable:int=report.actors[1].dealt
	var old:Dictionary=event(199,1,4,100);old.run_id=0;report.consume(old)
	check(report.actors[1].dealt==stable,"old run event ignored")
	for i in range(2200):report.system(i*.1,"Action %d"%i)
	check(report.recent.size()==1000,"journal contains only the latest 1000 entries")
	check(report.recent[0].text=="Action 1200" and report.recent.back().text=="Action 2199","old entries evicted in chronological order")
	report.begin(2);check(report.actors.is_empty() and report.entries==1,"new combat fully resets all statistics and journal")
	report.register_actor(1,"Mako",0,0,180,60,0)
	for wave in range(1,31):
		report.begin_wave(wave,wave)
		for i in range(6):report.register_actor(100+wave*6+i,"Squelette",1,i,60,0,wave)
		check(report.actors.size()==7 and report.recent.size()<=1000,"bounded actor records over infinite wave %d"%wave)
	# Real executors prove effective (clipped) HP and no gameplay side effects.
	var app=App.instantiate();app.save_path="";app.combat_settings_path="";add_child(app);await settle();app.open_arena();await settle()
	var game=app.combat;game.set_process(false);game.set_physics_process(false)
	var sim=game.simulation;sim.rules={"mako":[],"anne":[]};sim.reset();game.action_presenter.reset_run(sim.run_id);game._present()
	var mako=sim.hero(&"mako");var anne=sim.hero(&"anne");var foe=sim.enemies[0]
	mako.place(Vector2.ZERO);foe.place(Vector2(.8,0));foe.state.damage(53)
	check(mako.action.request(&"lightning",foe)>0,"real lightning request accepted")
	mako.action.advance(2);sim._collect_visual_events(sim.all_units())
	check(sim.report.actors[mako.combat_id].dealt==7 and sim.report.actors[foe.combat_id].received==7,"overkill credits only seven actual HP")
	check(mako.action.spent==30 and not sim.report.actors[foe.combat_id].alive,"observer preserves mana and death contracts")
	var lines:int=sim.report.entries;sim._collect_visual_events(sim.all_units())
	check(sim.report.entries==lines,"drained events cannot be recounted")
	anne.place(Vector2(0,.8));anne.state.damage(5)
	check(anne.action.request(&"heal",anne)>0,"real self-heal accepted")
	anne.action.advance(1.5);sim._collect_visual_events(sim.all_units())
	check(sim.report.actors[anne.combat_id].healed==5 and anne.action.spent==20,"overheal credits five actual HP and charges normal mana")
	check(sim.report.mvp_id()==mako.combat_id,"MVP uses effective contributions")
	anne.action.cancel();anne.action.cooldowns.clear();anne.state.damage(15)
	anne.action.request(&"heal",anne);anne.action.advance(1.5);sim._collect_visual_events(sim.all_units())
	check(sim.report.actors[anne.combat_id].healed==20 and sim.report.mvp_id()==anne.combat_id,"healer can become MVP")
	check(sim.report.ordered()[0].id==mako.combat_id,"hero order remains decreasing damage despite MVP badge")
	mako.action.cancel();mako.action.cooldowns.clear()
	mako.action.request(&"lightning",sim.enemies[1]);sim._collect_visual_events(sim.all_units())
	var spent:int=mako.action.spent;sim.enemies[1].state.damage(999);sim._collect_visual_events(sim.all_units())
	check(mako.action.spent==spent and sim.report.recent.any(func(row):return "annulation" in row.text and not "aucun PM" in row.text),"cancelled cast is logged without spending mana")
	var hero_damage:int=sim.report.actors[mako.combat_id].dealt
	var old_ids:Array=sim.enemies.map(func(unit):return unit.combat_id)
	for unit in sim.enemies:unit.state.damage(999)
	game._physics_process(.01)
	for i in range(181):game._physics_process(1.0/60.0)
	check(sim.wave_number==2 and sim.report.actors.size()==8 and old_ids.all(func(id):return not sim.report.actors.has(id)),"real new wave clears dead enemy rows")
	check(sim.report.actors[mako.combat_id].dealt==hero_damage and sim.report.recent.any(func(row):return "Squelette #1" in row.text),"hero totals and recent journal survive real wave")
	for unit in sim.all_units():unit.mover.speed=0
	mako.action.cancel();mako.action.cooldowns.clear();mako.action.mana=60
	check(mako.action.request(&"booster",mako)>0,"real booster commitment accepted")
	mako.action.advance(1.5);sim._collect_visual_events(sim.all_units())
	check(mako.buffs.has(&"booster") and sim.report.actors[mako.combat_id].buffs.has("booster"),"actual buff state reaches journal adapter")
	for tick in range(1801):game._physics_process(1.0/30.0)
	check(not mako.buffs.has(&"booster") and sim.report.recent.filter(func(row):return row.kind=="buff_end" and "Mako" in row.text and "prend fin" in row.text).size()==1,"actual expiry emits exactly one journal line")
	app.queue_free();await settle()
	# Actual touch and independent scrolling, both portrait sizes.
	for resolution in [Vector2i(540,960),Vector2i(360,640)]:
		var viewport:=SubViewport.new();viewport.size=resolution;add_child(viewport)
		app=App.instantiate();app.save_path="";app.combat_settings_path="user://statistics001-%d.cfg"%resolution.x
		viewport.add_child(app);await settle();viewport.notify_mouse_entered();app.open_arena();await settle()
		game=app.combat;game.set_process(false);game.set_physics_process(false)
		check(game.statistics_button.get_global_rect().position.x-game.safe_rect.position.x==game.safe_rect.end.x-game.settings_button.get_global_rect().end.x,"symmetric left and right buttons")
		tap(viewport,game.statistics_button);await settle()
		var menu=game.statistics_menu
		check(menu.visible and not game.paused,"actual touch opens statistics without pausing")
		var time:float=game.simulation.clock.elapsed;game._physics_process(.02)
		check(game.simulation.clock.elapsed>time and game.simulation.report.entries>0,"capture continues while menu open")
		tap(viewport,game.journal_button);await settle()
		check(menu.journal_mode and menu.journal_panel.visible and not menu.stats_panel.visible and game._touch_scrollers().size()==1,"journal replaces statistics from its own button")
		check(game.safe_rect.encloses(menu.stats_panel.get_global_rect()) and game.safe_rect.encloses(menu.journal_panel.get_global_rect()),"both views fit portrait safe area")
		check(menu.get_global_rect().end.y<game.hero_panels[0].get_global_rect().position.y and menu.get_global_rect().end.y>game.wave_counter.get_global_rect().position.y,"views cover wave counter and stop above hero panels")
		check(is_equal_approx(menu.get_global_rect().position.x,game.hero_panels[0].get_global_rect().position.x) and is_equal_approx(menu.get_global_rect().end.x,game.hero_panels[1].get_global_rect().end.x),"report borders align with hero panel borders")
		check(is_equal_approx(game.hero_panels[0].get_global_rect().position.y-menu.get_global_rect().end.y,12.0),"report bottom leaves twelve pixels above hero panels")
		check(menu.journal_panel.size.x==menu.size.x and menu.find_children("*","Button",true,false).size()==2,"journal uses entire width without a chevron")
		for i in range(2200):game.simulation.report.system(i*.1,"Ligne témoin %d"%i)
		menu.refresh(true);await settle()
		check(game.simulation.report.recent.size()==1000 and menu.console.get_paragraph_count()==1001,"one continuous console contains all 1000 cached entries")
		check(menu.console.get_parsed_text().contains("Ligne témoin 1200") and not menu.console.get_parsed_text().contains("Ligne témoin 1199"),"continuous journal starts at oldest retained entry")
		check(menu.journal_panel.find_children("*","CheckBox",true,false).is_empty(),"journal has no capacity options")
		for i in range(3):game.simulation.report.system(300+i,"Nouvelle entrée %d"%i)
		menu.refresh(true);await settle()
		check(menu.console.get_paragraph_count()==1001 and not menu.console.get_parsed_text().contains("Ligne témoin 1200") and menu.console.get_parsed_text().contains("Nouvelle entrée 2"),"incremental pruning keeps console bounded without stale paragraphs")
		tap(viewport,menu.playback);await settle()
		check(game.paused and menu.playback_paused and menu.visible and menu.journal_mode and not game.pause_layer.visible,"inline pause leaves journal visible without pause menu")
		var frozen:Array=[game.simulation.clock.elapsed,game.simulation.hero(&"mako").action.elapsed,game.simulation.hero(&"mako").action.mana]
		for tick in range(12):game._physics_process(.1)
		check(frozen==[game.simulation.clock.elapsed,game.simulation.hero(&"mako").action.elapsed,game.simulation.hero(&"mako").action.mana],"inline pause freezes actual combat actions and mana")
		menu.journal_scroll.scroll_vertical=0;await settle()
		var journal_at:Vector2=menu.journal_scroll.get_global_rect().get_center()
		var journal_finger:=InputEventScreenTouch.new();journal_finger.index=0;journal_finger.position=journal_at;journal_finger.pressed=true;viewport.push_input(journal_finger,true)
		var journal_drag:=InputEventScreenDrag.new();journal_drag.index=0;journal_drag.position=journal_at-Vector2(0,60);journal_drag.relative=Vector2(0,-60);viewport.push_input(journal_drag,true)
		journal_finger=InputEventScreenTouch.new();journal_finger.index=0;journal_finger.position=journal_drag.position;journal_finger.pressed=false;viewport.push_input(journal_finger,true);await settle()
		check(menu.journal_scroll.scroll_vertical>0 and game.paused,"journal scroll remains active during inline pause")
		tap(viewport,menu.direct);await settle();check(menu.follow_live,"Direct returns to latest entry")
		tap(viewport,menu.playback);await settle()
		check(not game.paused and not menu.playback_paused and menu.journal_mode,"play resumes without closing journal")
		game._physics_process(.01);check(game.simulation.clock.elapsed>frozen[0],"combat resumes from inline play")
		check(not FileAccess.file_exists(app.combat_settings_path),"journal never writes a cache or preference file")
		tap(viewport,game.statistics_button);await settle()
		check(not menu.journal_mode and menu.stats_panel.visible and not menu.journal_panel.visible and game._touch_scrollers().size()==2,"statistics button opens two independent columns")
		check(menu.stats_panel.size.x==menu.size.x and menu.hero_scroll.size.x==menu.enemy_scroll.size.x,"statistics use full width with equal columns")
		check(menu.hero_list.entries.all(func(row):return row.team==0) and menu.enemy_list.entries.all(func(row):return row.team==1),"heroes and enemies remain in their own columns")
		check(not game.wave_counter.visible,"wave counter hidden beneath report overlay")
		for i in range(45):game.simulation.report.register_actor(100000+i,"Squelette #%d"%i,1,i,60,0,0)
		menu.refresh(true);await settle()
		var at:Vector2=menu.enemy_scroll.get_global_rect().get_center()
		var finger:=InputEventScreenTouch.new();finger.index=0;finger.position=at;finger.pressed=true;viewport.push_input(finger,true)
		var drag:=InputEventScreenDrag.new();drag.index=0;drag.position=at-Vector2(0,70);drag.relative=Vector2(0,-70);viewport.push_input(drag,true)
		finger=InputEventScreenTouch.new();finger.index=0;finger.position=drag.position;finger.pressed=false;viewport.push_input(finger,true);await settle()
		check(menu.enemy_scroll.scroll_vertical>0,"stats list scrolls through actual touch")
		check(menu.enemy_list.get_child_count()==0,"virtual stats rows create no per-actor control trees")
		check(menu.visible and not menu.journal_mode,"statistics stay open after scrolling")
		game.handle_back();await settle();check(not menu.visible and not game.paused,"Back closes stats without pause")
		tap(viewport,game.statistics_button);await settle();tap(viewport,game.settings_button);await settle()
		check(not menu.visible and game.settings_menu.visible,"settings and statistics are mutually exclusive")
		tap(viewport,game.statistics_button);await settle();game.notification(NOTIFICATION_APPLICATION_FOCUS_OUT);game.notification(NOTIFICATION_APPLICATION_PAUSED);await settle()
		check(not menu.visible and game.paused and game.pause_layer.visible,"background closes stats and requires normal resume")
		game.notification(NOTIFICATION_APPLICATION_RESUMED);game.notification(NOTIFICATION_APPLICATION_FOCUS_IN);await settle()
		game._replay_combat();await settle()
		check(game.simulation.report.actors.size()==8 and game.simulation.report.actors.values().all(func(row):return row.dealt==0 and row.received==0 and row.healed==0),"replay resets all statistics")
		check(game.simulation.report.recent.size()<=1000 and not game.simulation.report.recent.any(func(row):return "Ligne témoin" in row.text),"replay clears entire journal")
		var pref_path:String=app.combat_settings_path
		viewport.queue_free();await settle();
		if FileAccess.file_exists(pref_path):DirAccess.remove_absolute(pref_path)
	check(int(Performance.get_monitor(Performance.OBJECT_ORPHAN_NODE_COUNT))==0,"no retained actors menus or orphan nodes")
	var label:=Label.new();label.text="%d controles, %d echecs"%[checks,failures];add_child(label);print(label.text)
